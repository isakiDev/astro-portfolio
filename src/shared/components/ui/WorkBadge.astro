---
interface Props {
  isWorking?: boolean;
  href?: string;
  workingText?: string;
  availableText?: string;
}

const {
  isWorking = false,
  href = "https://www.linkedin.com/in/isakidev",
  workingText = "Transformando café en código ☕",
  availableText = "Disponible para trabajar",
}: Props = Astro.props;
---

<a
  class:list={[
    "relative inline-flex items-center text-xs gap-2 font-medium py-1.5 px-3 rounded-xl border opacity-80 duration-200 hover:opacity-100",
    {
      "bg-amber-900/40 text-amber-200 border-amber-800/50 hover:border-amber-700/60 hover:shadow-amber-900/20":
        isWorking,
    },
    {
      "bg-green-950/60 text-green-200 border-green-900 hover:border-green-800 hover:shadow-green-900/20":
        !isWorking,
    },
  ]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={isWorking ? workingText : availableText}
>
  <span class="relative flex size-2 shrink-0">
    <span
      class:list={[
        "absolute inline-flex size-full animate-ping rounded-full opacity-75",
        { "bg-amber-300": isWorking, "bg-green-300": !isWorking },
      ]}></span>
    <span
      class:list={[
        "relative inline-flex size-2 rounded-full ring-2",
        {
          "bg-amber-400 ring-amber-400/30": isWorking,
          "bg-green-400 ring-green-400/30": !isWorking,
        },
      ]}></span>
  </span>
  <span>{isWorking ? workingText : availableText}</span>
</a>
